; Run only against an initialized, disposable volume. The writes overwrite data.
; Supply the scratch mapping with --filename=/dev/mapper/<scratch-volume>.
[global]
ioengine=io_uring
rw=randwrite
bs=4k
size=8G
direct=1
iodepth=32
numjobs=4
time_based=1
runtime=15
ramp_time=3
randrepeat=1
randseed=2701
norandommap=1
group_reporting=1
end_fsync=1
allow_file_create=0

[volume-randwrite]
