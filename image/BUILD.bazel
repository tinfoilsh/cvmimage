package(default_visibility = ["//visibility:public"])

load("@rules_distroless//distroless:defs.bzl", "cacerts")

cacerts(
    name = "ubuntu-runtime-cacerts",
    mode = "0644",
    package = "@ubuntu_runtime//ca-certificates:data",
)

exports_files([
    "runtime-packages.lock.json",
    "runtime-packages.yaml",
    "runtime-sources.lock.json",
])

sh_test(
    name = "runtime-package-lock-test",
    srcs = ["//scripts:compare_runtime_package_lock.sh"],
    args = [
        "$(location :runtime-packages.lock.json)",
        "$(location @@rules_distroless++apt+ubuntu_runtime_resolve//:lockfile)",
    ],
    data = [
        ":runtime-packages.lock.json",
        "@@rules_distroless++apt+ubuntu_runtime_resolve//:lockfile",
    ],
)

filegroup(
    name = "runtime-package-layers",
    srcs = ["@ubuntu_runtime//:packages"],
)

filegroup(
    name = "runtime-source-archives",
    srcs = [
        "@runtime_source_docker_static//:archive",
        "@runtime_source_libnvidia_cfg1//:archive",
        "@runtime_source_libnvidia_compute//:archive",
        "@runtime_source_libnvidia_container_tools//:archive",
        "@runtime_source_libnvidia_container1//:archive",
        "@runtime_source_libnvidia_gpucomp//:archive",
        "@runtime_source_libnvidia_nscq//:archive",
        "@runtime_source_nvidia_container_toolkit//:archive",
        "@runtime_source_nvidia_container_toolkit_base//:archive",
        "@runtime_source_nvidia_fabricmanager//:archive",
        "@runtime_source_nvidia_firmware//:archive",
        "@runtime_source_nvidia_persistenced//:archive",
    ],
)
