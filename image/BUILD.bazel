package(default_visibility = ["//visibility:public"])

load("@rules_distroless//distroless:defs.bzl", "cacerts")
load(
    "@rules_pkg//pkg:mappings.bzl",
    "pkg_attributes",
    "pkg_files",
    "pkg_mkdirs",
    "pkg_mklink",
    "strip_prefix",
)
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Only package data archives enter the measured rootfs; Debian maintainer
# scripts and control archives are neither included nor executed. Debconf and
# libcap2-bin stay pinned in the canonical lock as dependency provenance, but
# their administrative payloads are not needed by the fixed runtime.
_RUNTIME_PACKAGE_LAYERS = [
    "@ubuntu_runtime//ca-certificates:data",
    "@ubuntu_runtime//gcc-16-base:data",
    "@ubuntu_runtime//iproute2:data",
    "@ubuntu_runtime//libbpf1:data",
    "@ubuntu_runtime//libbsd0:data",
    "@ubuntu_runtime//libc-bin:data",
    "@ubuntu_runtime//libc-gconv-modules-extra:data",
    "@ubuntu_runtime//libc6:data",
    "@ubuntu_runtime//libcap2:data",
    "@ubuntu_runtime//libcom-err2:data",
    "@ubuntu_runtime//libdb5.3t64:data",
    "@ubuntu_runtime//libedit2:data",
    "@ubuntu_runtime//libelf1t64:data",
    "@ubuntu_runtime//libgcc-s1:data",
    "@ubuntu_runtime//libgmp10:data",
    "@ubuntu_runtime//libgssapi-krb5-2:data",
    "@ubuntu_runtime//libjansson4:data",
    "@ubuntu_runtime//libk5crypto3:data",
    "@ubuntu_runtime//libkeyutils1:data",
    "@ubuntu_runtime//libkrb5-3:data",
    "@ubuntu_runtime//libkrb5support0:data",
    "@ubuntu_runtime//libmd0:data",
    "@ubuntu_runtime//libmnl0:data",
    "@ubuntu_runtime//libnftables1:data",
    "@ubuntu_runtime//libnftnl11:data",
    "@ubuntu_runtime//libpcre2-8-0:data",
    "@ubuntu_runtime//libseccomp2:data",
    "@ubuntu_runtime//libselinux1:data",
    "@ubuntu_runtime//libssl3t64:data",
    "@ubuntu_runtime//libstdc++6:data",
    "@ubuntu_runtime//libtinfo6:data",
    "@ubuntu_runtime//libtirpc-common:data",
    "@ubuntu_runtime//libtirpc3t64:data",
    "@ubuntu_runtime//libxml2-16:data",
    "@ubuntu_runtime//libxtables12:data",
    "@ubuntu_runtime//libzstd1:data",
    "@ubuntu_runtime//nftables:data",
    "@ubuntu_runtime//openssl-provider-legacy:data",
    "@ubuntu_runtime//openssl:data",
    "@ubuntu_runtime//zlib1g:data",
]

cacerts(
    name = "ubuntu-runtime-cacerts",
    mode = "0644",
    package = "@ubuntu_runtime//ca-certificates:data",
)

exports_files([
    "runtime-packages.lock.json",
    "runtime-packages.yaml",
    "runtime-source-deb.BUILD.bazel",
    "runtime-source-docker.BUILD.bazel",
])

filegroup(
    name = "runtime-package-layers",
    srcs = _RUNTIME_PACKAGE_LAYERS,
)

filegroup(
    name = "nvidia-package-layers",
    srcs = [
        "@runtime_source_libnvidia_cfg1//:payload",
        "@runtime_source_libnvidia_compute//:payload",
        "@runtime_source_libnvidia_container_tools//:payload",
        "@runtime_source_libnvidia_container1//:payload",
        "@runtime_source_libnvidia_decode//:payload",
        "@runtime_source_libnvidia_gl//:payload",
        "@runtime_source_libnvidia_gpucomp//:payload",
        "@runtime_source_libnvidia_nscq//:payload",
        "@runtime_source_nvidia_container_toolkit//:payload",
        "@runtime_source_nvidia_container_toolkit_base//:payload",
        "@runtime_source_nvidia_fabricmanager//:payload",
        "@runtime_source_nvidia_firmware//:payload",
        "@runtime_source_nvidia_kernel_common//:payload",
        "@runtime_source_nvidia_persistenced//:payload",
    ],
)

pkg_files(
    name = "repository-rootfs-0644",
    srcs = [
        "rootfs/etc/containerd/config.toml",
        "rootfs/etc/docker/daemon.json",
        "rootfs/etc/group",
        "rootfs/etc/hostname",
        "rootfs/etc/hosts",
        "rootfs/etc/nftables.conf",
        "rootfs/etc/nsswitch.conf",
        "rootfs/etc/nvidia-container-runtime/config.toml",
        "rootfs/etc/passwd",
        "rootfs/etc/resolv.conf",
        "rootfs/etc/systemd/system-preset/00-tinfoil.preset",
        "rootfs/usr/lib/clock-epoch",
        "rootfs/usr/lib/os-release",
        "rootfs/usr/share/nvidia/nvswitch/fabricmanager.cfg",
    ],
    attributes = pkg_attributes(mode = "0644", uid = 0, gid = 0),
    strip_prefix = strip_prefix.from_pkg("rootfs"),
)

pkg_files(
    name = "repository-rootfs-0600",
    srcs = ["rootfs/etc/.pwd.lock"],
    attributes = pkg_attributes(mode = "0600", uid = 0, gid = 0),
    strip_prefix = strip_prefix.from_pkg("rootfs"),
)

pkg_files(
    name = "repository-rootfs-0640",
    srcs = [
        "rootfs/etc/gshadow",
        "rootfs/etc/shadow",
    ],
    attributes = pkg_attributes(mode = "0640", uid = 0, gid = 0),
    strip_prefix = strip_prefix.from_pkg("rootfs"),
)

pkg_files(
    name = "docker-static-payload",
    srcs = ["@runtime_source_docker_static//:payload"],
    attributes = pkg_attributes(mode = "0755", uid = 0, gid = 0),
    prefix = "usr/bin",
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "docker-static-rootfs-layer",
    srcs = [":docker-static-payload"],
    extension = "tar",
    mtime = 0,
    out = "docker-static-rootfs-layer.tar",
    owner = "0.0",
    portable_mtime = False,
    stamp = 0,
)

pkg_tar(
    name = "container-runtime-contract-rootfs-layer",
    srcs = [
        ":docker-static-payload",
        ":repository-rootfs-0644",
    ],
    extension = "tar",
    mtime = 0,
    out = "container-runtime-contract-rootfs-layer.tar",
    owner = "0.0",
    portable_mtime = False,
    stamp = 0,
)

pkg_files(
    name = "tinfoil-runtime-binaries",
    srcs = [
        "//:build/builder-work/output/artifacts/tinfoil-boot",
        "//:build/builder-work/output/artifacts/tinfoil-container-status",
        "//:build/builder-work/output/artifacts/tinfoil-egress",
        "//:build/builder-work/output/artifacts/tinfoil-init",
        "//:build/builder-work/output/artifacts/tinfoil-shim",
    ],
    attributes = pkg_attributes(mode = "0755", uid = 0, gid = 0),
    prefix = "usr/bin",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "debug-tinfoil-init",
    srcs = ["//:build/debug-work/output/artifacts/tinfoil-init"],
    attributes = pkg_attributes(mode = "0755", uid = 0, gid = 0),
    prefix = "usr/bin",
    strip_prefix = strip_prefix.files_only(),
)

pkg_mkdirs(
    name = "debug-root-home",
    dirs = ["root"],
    attributes = pkg_attributes(mode = "0700", uid = 0, gid = 0),
)

pkg_files(
    name = "nvattest-binary",
    srcs = ["//:build/rootfs-artifacts/nvattest/usr/bin/nvattest"],
    attributes = pkg_attributes(mode = "0755", uid = 0, gid = 0),
    prefix = "usr/bin",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "libnvat",
    srcs = ["//:build/rootfs-artifacts/nvattest/usr/lib/x86_64-linux-gnu/libnvat.so.1.2.2"],
    attributes = pkg_attributes(mode = "0644", uid = 0, gid = 0),
    prefix = "usr/lib/x86_64-linux-gnu",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "nvidia-kernel-modules",
    srcs = ["//kernel/out/rootfs-artifacts/nvidia-modules:modules"],
    attributes = pkg_attributes(mode = "0644", uid = 0, gid = 0),
    prefix = "usr/lib/tinfoil/kernel-modules",
    strip_prefix = strip_prefix.files_only(),
)

pkg_mkdirs(
    name = "rootfs-mountpoints",
    dirs = [
        "dev",
        "mnt",
        "mnt/ramdisk",
        "proc",
        "run",
        "sys",
        "tmp",
        "var",
        "var/tmp",
    ],
    attributes = pkg_attributes(mode = "0755", uid = 0, gid = 0),
)

pkg_mklink(
    name = "link-lib64",
    link_name = "lib64",
    target = "usr/lib64",
)

pkg_mklink(
    name = "link-sbin",
    link_name = "sbin",
    target = "usr/sbin",
)

pkg_mklink(
    name = "link-var-run",
    link_name = "var/run",
    target = "../run",
)

pkg_mklink(
    name = "link-libnvat-soname",
    link_name = "usr/lib/x86_64-linux-gnu/libnvat.so.1",
    target = "libnvat.so.1.2.2",
)

pkg_tar(
    name = "runtime-overlay",
    srcs = [
        ":libnvat",
        ":link-lib64",
        ":link-libnvat-soname",
        ":link-sbin",
        ":link-var-run",
        ":nvattest-binary",
        ":nvidia-kernel-modules",
        ":repository-rootfs-0600",
        ":repository-rootfs-0640",
        ":repository-rootfs-0644",
        ":rootfs-mountpoints",
        ":tinfoil-runtime-binaries",
    ],
    allow_duplicates_from_deps = False,
    create_parents = True,
    extension = "tar",
    mtime = 0,
    out = "runtime-overlay.tar",
    owner = "0.0",
    portable_mtime = False,
    stamp = 0,
)

pkg_tar(
    name = "rootfs",
    deps = [
        ":docker-static-rootfs-layer",
        ":nvidia-package-layers",
        ":runtime-package-layers",
        ":ubuntu-runtime-cacerts",
        ":runtime-overlay",
    ],
    allow_duplicates_from_deps = True,
    extension = "tar",
    out = "bazel-rootfs.tar",
    stamp = 0,
)

pkg_tar(
    name = "debug-overlay",
    srcs = [
        ":debug-root-home",
        ":debug-tinfoil-init",
    ],
    allow_duplicates_from_deps = False,
    create_parents = True,
    extension = "tar",
    mtime = 0,
    out = "debug-overlay.tar",
    owner = "0.0",
    portable_mtime = False,
    stamp = 0,
)

pkg_tar(
    name = "debug-layer",
    deps = [
        "@runtime_source_debug_busybox//:payload",
        ":debug-overlay",
    ],
    allow_duplicates_from_deps = True,
    extension = "tar",
    out = "bazel-debug-layer.tar",
    stamp = 0,
)
