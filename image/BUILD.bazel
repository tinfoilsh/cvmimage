package(default_visibility = ["//visibility:public"])

load("@rules_distroless//distroless:defs.bzl", "cacerts")
load(
    ":runtime_archive.bzl",
    "runtime_archive",
    "runtime_archive_lock_check",
    "runtime_package_inputs_manifest",
)
load(":runtime_artifacts.bzl", "runtime_artifacts")
load(":runtime_package_inputs.bzl", "RUNTIME_PACKAGE_INPUTS")
load(":rootfs.bzl", "rootfs")

_CA_CERTIFICATES_SOURCE_ID = "ca-certificates_20260223_amd64"

cacerts(
    name = "ubuntu-runtime-cacerts",
    mode = "0644",
    package = RUNTIME_PACKAGE_INPUTS[_CA_CERTIFICATES_SOURCE_ID],
)

_RUNTIME_PACKAGE_ARCHIVES = dict(RUNTIME_PACKAGE_INPUTS)
_RUNTIME_PACKAGE_ARCHIVES[_CA_CERTIFICATES_SOURCE_ID] = ":ubuntu-runtime-cacerts"

# Generated/declarative lock data is intentionally kept separate from build
# rules so its reviewable size is not confused with executable mechanism.
exports_files([
    "rootfs.bzl",
    "runtime-packages.lock.json",
    "runtime-package-members.lock.json",
    "runtime-packages.yaml",
    "runtime-sources.lock.json",
])

sh_test(
    name = "runtime-package-lock-test",
    srcs = ["//scripts:compare_runtime_package_lock.sh"],
    args = [
        "$(location :runtime-packages.lock.json)",
        "$(location @@rules_distroless++apt+ubuntu_runtime_resolve//:lockfile)",
    ],
    data = [
        ":runtime-packages.lock.json",
        "@@rules_distroless++apt+ubuntu_runtime_resolve//:lockfile",
    ],
)

_RUNTIME_SOURCES = {
    "docker_static": "@runtime_source_docker_static",
    "libnvidia_cfg1": "@runtime_source_libnvidia_cfg1",
    "libnvidia_compute": "@runtime_source_libnvidia_compute",
    "libnvidia_container_tools": "@runtime_source_libnvidia_container_tools",
    "libnvidia_container1": "@runtime_source_libnvidia_container1",
    "libnvidia_gpucomp": "@runtime_source_libnvidia_gpucomp",
    "libnvidia_nscq": "@runtime_source_libnvidia_nscq",
    "nvidia_container_toolkit": "@runtime_source_nvidia_container_toolkit",
    "nvidia_container_toolkit_base": "@runtime_source_nvidia_container_toolkit_base",
    "nvidia_fabricmanager": "@runtime_source_nvidia_fabricmanager",
    "nvidia_firmware": "@runtime_source_nvidia_firmware",
    "nvidia_persistenced": "@runtime_source_nvidia_persistenced",
}

[
    runtime_archive(
        name = name + "_members",
        archive = repository + "//:archive",
        out = name + "-members.tar",
        source_lock = repository + "//:source.json",
    )
    for name, repository in _RUNTIME_SOURCES.items()
]

filegroup(
    name = "runtime-source-member-archives",
    srcs = [":" + name + "_members" for name in _RUNTIME_SOURCES],
)

runtime_archive_lock_check(
    name = "runtime-package-member-lock-check",
    out = "runtime-package-member-lock.validated",
    source_ids = sorted(RUNTIME_PACKAGE_INPUTS),
    source_lock = ":runtime-package-members.lock.json",
)

runtime_package_inputs_manifest(
    name = "runtime-package-inputs-manifest",
    out = "runtime-package-inputs.tsv",
    sources = _RUNTIME_PACKAGE_ARCHIVES,
)

[
    runtime_archive(
        name = source_id + "_members",
        archive = archive,
        out = source_id + "-members.tar",
        source_id = source_id,
        source_lock = ":runtime-package-members.lock.json",
        validation = ":runtime-package-member-lock-check",
    )
    for source_id, archive in _RUNTIME_PACKAGE_ARCHIVES.items()
]

filegroup(
    name = "runtime-package-member-archives",
    srcs = [":" + source_id + "_members" for source_id in RUNTIME_PACKAGE_INPUTS],
)

runtime_artifacts(
    name = "runtime-artifact-members",
)

rootfs(
    name = "rootfs",
)
