# Explicit Tinfoil CVM kernel security and functionality contract.
#
# The repository-owned defconfig supplies the pinned 7.0 dependency closure.
# This fragment makes the security boundary reviewable and is checked both
# before and after Kconfig resolution. NVIDIA is the only external module
# family; no in-tree symbol may resolve to =m.

CONFIG_MODULES=y
CONFIG_LOCALVERSION="-28-generic"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_KMOD is not set
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_FORCE_LOAD is not set
# CONFIG_MODULE_FORCE_UNLOAD is not set
# CONFIG_MODULE_UNLOAD_TAINT_TRACKING is not set
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_SECURITY_LOCKDOWN_LSM_EARLY is not set
# CONFIG_LOCK_DOWN_IN_SECURE_BOOT is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MICROCODE_LATE_LOADING is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KEXEC_JUMP is not set
# CONFIG_KEXEC_HANDOVER is not set

# CONFIG_PROC_KCORE is not set
# CONFIG_KGDB is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_COREDUMP is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_CGROUP_BPF=y
# CONFIG_BPF_PRELOAD is not set
# CONFIG_USERFAULTFD is not set
CONFIG_USER_NS=y

# CONFIG_COMPAT is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32 is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_BINFMT_MISC is not set

# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_DMI is not set
# CONFIG_DMIID is not set
# CONFIG_DMI_SYSFS is not set
# CONFIG_DMI_SCAN_MACHINE_NON_EFI_FALLBACK is not set
# CONFIG_ACPI_TABLE_UPGRADE is not set
# CONFIG_EFI_HANDOVER_PROTOCOL is not set
# CONFIG_EFI_MIXED is not set
# CONFIG_EFI_RUNTIME_MAP is not set
# CONFIG_EFI_SOFT_RESERVE is not set
# CONFIG_APPLE_PROPERTIES is not set
# CONFIG_RESET_ATTACK_MITIGATION is not set
# CONFIG_EFI_RCI2_TABLE is not set
CONFIG_EFI_DISABLE_RUNTIME=y
# CONFIG_EFI_COCO_SECRET is not set
# CONFIG_OVMF_DEBUG_LOG is not set
# CONFIG_EFI_CUSTOM_SSDT_OVERLAYS is not set
# CONFIG_EFIVAR_FS is not set
# CONFIG_LIVEPATCH is not set

CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_PANIC_ON_OOPS=y
# CONFIG_MAGIC_SYSRQ is not set
CONFIG_STRICT_MODULE_RWX=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
# CONFIG_IOMMU_DEFAULT_DMA_LAZY is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_WERROR=y
CONFIG_FRAME_WARN=2048
# CONFIG_SLAB_MERGE_DEFAULT is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_SAFESETID is not set
# CONFIG_SECURITY_IPE is not set
CONFIG_LSM="landlock,yama"
# CONFIG_KFENCE is not set
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536

CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CONFIGFS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BLOCK=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_DM_BUILTIN=y
CONFIG_DM_BUFIO=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
# CONFIG_DM_UEVENT is not set
CONFIG_EXT4_FS=y
CONFIG_JBD2=y
CONFIG_FS_MBCACHE=y
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_BLK_DEV_LOOP=y
# CONFIG_FUSE_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_FS_VERITY is not set
# CONFIG_ATA is not set
# CONFIG_LIBNVDIMM is not set
# CONFIG_X86_PMEM_LEGACY is not set
# CONFIG_DAX is not set

CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_LLC=y
CONFIG_STP=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NET_SCH_FQ_CODEL=y
# CONFIG_MPTCP is not set
# CONFIG_INET_PSP is not set
# CONFIG_IP_MROUTE is not set
# CONFIG_NET_EMATCH is not set
# CONFIG_NET_CLS is not set
# CONFIG_NET_CLS_ACT is not set

CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_ECDSA=y
CONFIG_CRYPTO_ECDH=y

CONFIG_TDX_GUEST_DRIVER=y
CONFIG_TSM_REPORTS=y
CONFIG_SEV_GUEST=y
CONFIG_ACPI=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_WMI=y

# CONFIG_HOTPLUG_PCI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
# CONFIG_SOUND is not set
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_VT is not set
# CONFIG_WATCHDOG is not set
# CONFIG_X86_SGX is not set
# CONFIG_TCG_TPM is not set
# CONFIG_AGP is not set
# CONFIG_HAMRADIO is not set
# CONFIG_MCTP is not set
# CONFIG_RFKILL is not set
# CONFIG_RAPIDIO is not set
