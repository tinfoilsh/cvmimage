for p in "${debloat_paths[@]}"; do
    rm -rf "$BUILDROOT"$p
done

libdevmapper="$BUILDROOT/usr/lib/x86_64-linux-gnu/libdevmapper.so.1.02.1"
if ! grep -aq 'tinfoil-libdevmapper-noudev-v1' "$libdevmapper"; then
    echo "ERROR: libdevmapper is missing Tinfoil no-udev marker" >&2
    exit 1
fi
if command -v readelf >/dev/null 2>&1; then
    libdevmapper_deps="$(readelf -d "$libdevmapper")"
    if grep -Eq 'lib(udev|systemd|selinux)\.so' <<<"$libdevmapper_deps"; then
        echo "ERROR: libdevmapper still links udev/systemd/selinux" >&2
        printf '%s\n' "$libdevmapper_deps" >&2
        exit 1
    fi
fi
rm -f "$BUILDROOT/usr/lib/x86_64-linux-gnu/libudev.so.1" \
      "$BUILDROOT"/usr/lib/x86_64-linux-gnu/libudev.so.1.* \
      "$BUILDROOT/usr/lib/x86_64-linux-gnu/libudev-tinfoil-inactive-shim.so.1"

ln -sfn ../proc/self/mounts "$BUILDROOT/etc/mtab"
install -d -m 1777 "$BUILDROOT/var/tmp"

install -d -m 0755 "$BUILDROOT/usr/lib/tmpfiles.d"
cat > "$BUILDROOT/usr/lib/tmpfiles.d/tinfoil-runtime.conf" <<'EOF'
# Tinfoil CVM minimal tmpfiles policy.
d /run/lock 1777 root root -
L /run/shm - - - - /dev/shm
d /run/log 0755 root root -
d /run/log/journal 2755 root systemd-journal -
d /var/log/journal 2755 root systemd-journal -
EOF

install -d -m 0755 "$BUILDROOT/usr/lib/sysctl.d"
cat > "$BUILDROOT/usr/lib/sysctl.d/tinfoil-runtime.conf" <<'EOF'
# Tinfoil CVM minimal sysctl policy.
#
# The stock /usr/lib/sysctl.d is deleted from this image, which also drops
# systemd's 50-default.conf. The fs.protected_* keys below restore the
# sticky-directory symlink/hardlink/fifo protections that file provided;
# they default to off in the kernel and have no Kconfig equivalent, and they
# are global (they also protect container processes).
fs.protected_hardlinks = 1
fs.protected_symlinks = 1
fs.protected_regular = 2
fs.protected_fifos = 1
kernel.dmesg_restrict = 1
kernel.kptr_restrict = 1
kernel.printk = 4 4 1 7
kernel.sysrq = 0
kernel.yama.ptrace_scope = 1
-net.core.default_qdisc = fq_codel
net.ipv4.conf.default.rp_filter = 2
net.ipv4.conf.all.rp_filter = 2
vm.max_map_count = 1048576
vm.mmap_min_addr = 65536
EOF

containerd_unit="$BUILDROOT/usr/lib/systemd/system/containerd.service"
if [ -f "$containerd_unit" ]; then
    sed -i -E 's/(^After=| )dbus\.service( |$)/\1/g; s/^After=[[:space:]]*/After=/; s/[[:space:]]+$//' "$containerd_unit"
fi

docker_unit="$BUILDROOT/usr/lib/systemd/system/docker.service"
if [ -f "$docker_unit" ]; then
    sed -i -E '
        /^After=/ s/[[:space:]]*network-online\.target//g
        /^After=/ s/[[:space:]]*nss-lookup\.target//g
        /^After=/ s/[[:space:]]*firewalld\.service//g
        /^After=/ s/[[:space:]]*time-set\.target//g
        /^Wants=/ s/[[:space:]]*network-online\.target//g
        /^After=$/d
        /^Wants=$/d
    ' "$docker_unit"
fi

fabricmanager_unit="$BUILDROOT/usr/lib/systemd/system/nvidia-fabricmanager.service"
if [ -f "$fabricmanager_unit" ]; then
    sed -i -E '
        /^After=/ s/[[:space:]]*network-online\.target//g
        /^Requires=/ s/[[:space:]]*network-online\.target//g
        /^After=$/d
        /^Requires=$/d
    ' "$fabricmanager_unit"
fi

networkd_unit="$BUILDROOT/usr/lib/systemd/system/systemd-networkd.service"
if [ -f "$networkd_unit" ]; then
    sed -i -E '
        /udev/d
        /^(Sockets|Also)=/ s/[[:space:]]*systemd-networkd-resolve-hook\.socket//g
        /^(Sockets|Also)=/ s/[[:space:]]*systemd-networkd-varlink\.socket//g
        /^(Sockets|Also)=/ s/[[:space:]]*systemd-network-generator\.service//g
        /^(Sockets|Also)=/ s/[[:space:]]*systemd-networkd-wait-online\.service//g
        /^(Before|Conflicts)=/ s/[[:space:]]*initrd-switch-root\.target//g
        /^After=/ s/[[:space:]]*systemd-udevd\.service//g
        /^After=/ s/[[:space:]]*systemd-sysusers\.service//g
        /^Wants=/ s/[[:space:]]*systemd-networkd-persistent-storage\.service//g
        /^BusName=org\.freedesktop\.network1$/d
        /^ImportCredential=network\.wireguard\.\*$/d
        /^Alias=dbus-org\.freedesktop\.network1\.service$/d
        /^After=$/d
        /^Wants=$/d
        /^Before=$/d
        /^Conflicts=$/d
        /^Also=$/d
    ' "$networkd_unit"
fi

tmpfiles_setup_unit="$BUILDROOT/usr/lib/systemd/system/systemd-tmpfiles-setup.service"
if [ -f "$tmpfiles_setup_unit" ]; then
    sed -i -E '
        /^After=/ s/[[:space:]]*systemd-sysusers\.service//g
        /^(Before|Conflicts)=/ s/[[:space:]]*initrd-switch-root\.target//g
        /^ImportCredential=/d
        /^RestrictSUIDSGID=no$/d
        /^After=$/d
        /^Before=$/d
        /^Conflicts=$/d
    ' "$tmpfiles_setup_unit"
fi

for tmpfiles_unit in "$BUILDROOT"/usr/lib/systemd/system/systemd-tmpfiles-*.service; do
    [ -e "$tmpfiles_unit" ] || continue
    sed -i -E '
        /^ImportCredential=/d
        /^RestrictSUIDSGID=no$/d
    ' "$tmpfiles_unit"
done

sysctl_unit="$BUILDROOT/usr/lib/systemd/system/systemd-sysctl.service"
if [ -f "$sysctl_unit" ]; then
    sed -i -E '
        /^ImportCredential=sysctl\.\*$/d
        /^After=/ s/[[:space:]]*systemd-modules-load\.service//g
        /^After=$/d
    ' "$sysctl_unit"
fi

journald_unit="$BUILDROOT/usr/lib/systemd/system/systemd-journald.service"
if [ -f "$journald_unit" ]; then
    sed -i -E '
        /^(After|Sockets)=/ s/[[:space:]]*systemd-journald-audit\.socket//g
        /^(After|Sockets)=/ s/[[:space:]]*systemd-journald-dev-log\.socket//g
        /^After=/ s/[[:space:]]*syslog\.socket//g
        /^CapabilityBoundingSet=/ s/[[:space:]]*CAP_AUDIT_CONTROL//g
        /^CapabilityBoundingSet=/ s/[[:space:]]*CAP_AUDIT_READ//g
        /^(After|Sockets)=$/d
    ' "$journald_unit"
fi

rm -f "$BUILDROOT/etc/resolv.conf"
cat > "$BUILDROOT/etc/resolv.conf" <<'EOF'
# Tinfoil CVM static resolver.
#
# The host bridge dnsmasq is DHCP-only and advertises these upstream resolvers.
# Keep DNS data-plane resolution direct so systemd-resolved and its local stub
# listener are not part of the measured runtime TCB.
nameserver 1.1.1.1
nameserver 1.0.0.1
options edns0
search .
EOF

if [ -f "$BUILDROOT/etc/nsswitch.conf" ]; then
    sed -i -E 's/^hosts:.*/hosts: files dns/' "$BUILDROOT/etc/nsswitch.conf"
fi

if [ -f "$BUILDROOT/etc/passwd" ]; then
    sed -i -E 's#^(root:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:).*$#\1/bin/sh#' "$BUILDROOT/etc/passwd"
fi
cat > "$BUILDROOT/etc/shells" <<'EOF'
# /etc/shells: valid login shells
/bin/sh
/usr/bin/sh
/usr/bin/dash
EOF

ensure_static_group() {
    local name="$1"
    local preferred_gid="$2"
    local group_file="$BUILDROOT/etc/group"
    local gid="$preferred_gid"

    [ -f "$group_file" ] || return 0
    if grep -Eq "^${name}:" "$group_file"; then
        return 0
    fi

    if awk -F: -v gid="$gid" '$3 == gid { found=1 } END { exit found ? 0 : 1 }' "$group_file"; then
        # Fallback scan starts at 300: above Debian's statically-allocated
        # 0-99 range and the 100-299 block used by common packaged system
        # groups, while staying well below SYS_GID_MIN (100)..999 dynamic
        # allocations already present in the image.
        gid="$(awk -F: 'BEGIN { gid=300 } { used[$3]=1 } END { while (used[gid]) gid++; print gid }' "$group_file")"
    fi

    printf '%s:x:%s:\n' "$name" "$gid" >> "$group_file"
}

ensure_static_group render 107

# Build inputs are still needed during package installation because NVIDIA DKMS
# and the patched TDX module both compile against the stock kernel. Once those
# modules exist, remove the executable build surface and source trees from the
# runtime rootfs.
