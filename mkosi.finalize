#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob

# Keep generated account files deterministic when the helper is available.
if command -v mkosi-chroot >/dev/null 2>&1; then
    mkosi-chroot pwck --sort >/dev/null 2>&1 || true
    mkosi-chroot grpck --sort >/dev/null 2>&1 || true
fi

# Remove runtime logs and caches while preserving their parent directories.
find "$BUILDROOT/var/log" -type f -delete 2>/dev/null || true
find "$BUILDROOT/var/cache" -mindepth 1 -delete 2>/dev/null || true
rm -rf "$BUILDROOT"/var/lib/apt/lists/* \
       "$BUILDROOT"/var/cache/apt/* \
       "$BUILDROOT"/var/cache/debconf/*-old

debloat_paths=(
    "/etc/apt"
    "/etc/cron.daily"
    "/etc/dkms"
    "/etc/dpkg"
    "/etc/init.d"
    "/etc/initramfs"
