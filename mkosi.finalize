    "/usr/sbin/dkms"
    "/usr/sbin/dpkg*"
    "/usr/sbin/fdisk"
    "/usr/sbin/fsck"
    "/usr/sbin/installkernel"
    "/usr/sbin/invoke-rc.d"
    "/usr/sbin/losetup"
    "/usr/sbin/mkfs"
    "/usr/sbin/mkswap"
    "/usr/sbin/pivot_root"
    "/usr/sbin/service"
    "/usr/sbin/sfdisk"
    "/usr/sbin/swapoff"
    "/usr/sbin/swapon"
    "/usr/sbin/update-rc.d"
    "/usr/sbin/wipefs"
    "/usr/sbin/add-shell"
    "/usr/sbin/adduser"
    "/usr/sbin/agetty"
    "/usr/sbin/chgpasswd"
    "/usr/sbin/chpasswd"
    "/usr/sbin/deluser"
    "/usr/sbin/groupadd"
    "/usr/sbin/groupdel"
    "/usr/sbin/groupmod"
    "/usr/sbin/grpck"
    "/usr/sbin/grpconv"
    "/usr/sbin/grpunconv"
    "/usr/sbin/iucode_tool"
    "/usr/sbin/newusers"
    "/usr/sbin/pam-auth-update"
    "/usr/sbin/pam_*"
    "/usr/sbin/pwck"
    "/usr/sbin/pwconv"
    "/usr/sbin/pwhistory_helper"
    "/usr/sbin/pwunconv"
    "/usr/sbin/remove-shell"
    "/usr/sbin/runuser"
    "/usr/sbin/shadowconfig"
    "/usr/sbin/sulogin"
    "/usr/sbin/update-passwd"
    "/usr/sbin/update-shells"
    "/usr/sbin/useradd"
    "/usr/sbin/userdel"
    "/usr/sbin/usermod"
    "/usr/sbin/vipw"
    "/usr/sbin/gnuchroot"
    "/usr/share/dkms"
    "/usr/src/linux-headers-*"
    "/usr/src/nvidia-*"
    "/var/lib/dkms"
)

for p in "${transient_build_paths[@]}"; do
    rm -rf "$BUILDROOT"$p
done

# Remove distro maintenance/helper script entry points that survive package
# pruning but are not used by the Tinfoil-owned boot path. Several point to
# interpreters that are intentionally absent from the measured runtime rootfs.
stale_runtime_helper_paths=(
    "/etc/security/namespace.init"
    "/bin/blkid"
    "/bin/mount"
    "/bin/umount"
    "/sbin/cryptsetup"
    "/sbin/blkid"
    "/sbin/dmsetup"
    "/sbin/dmstats"
    "/sbin/veritysetup"
    "/usr/bin/cryptsetup"
    "/usr/bin/bzdiff"
    "/usr/bin/blkid"
    "/usr/bin/bzexe"
    "/usr/bin/bzgrep"
    "/usr/bin/bzmore"
    "/usr/bin/c_rehash"
    "/usr/bin/egrep"
    "/usr/bin/fgrep"
    "/usr/bin/gunzip"
    "/usr/bin/gzexe"
    "/usr/bin/lzcmp"
    "/usr/bin/lzdiff"
    "/usr/bin/lzegrep"
    "/usr/bin/lzfgrep"
    "/usr/bin/lzgrep"
    "/usr/bin/lzless"
    "/usr/bin/lzmore"
    "/usr/bin/make-first-existing-target"
    "/usr/bin/mount"
    "/usr/bin/rgrep"
    "/usr/bin/routel"
    "/usr/bin/savelog"
    "/usr/bin/streamzip"
    "/usr/bin/tzselect"
    "/usr/bin/umount"
    "/usr/bin/which"
    "/usr/bin/which.debianutils"
    "/usr/bin/xzdiff"
    "/usr/bin/xzgrep"
    "/usr/bin/xzless"
    "/usr/bin/xzmore"
    "/usr/bin/zcat"
    "/usr/bin/zcmp"
    "/usr/bin/zdiff"
    "/usr/bin/zegrep"
    "/usr/bin/zfgrep"
    "/usr/bin/zforce"
    "/usr/bin/zgrep"
    "/usr/bin/zless"
    "/usr/bin/zmore"
    "/usr/bin/znew"
    "/usr/libexec/libselinux/selinux_compile_fcontexts"
    "/usr/sbin/blkdeactivate"
    "/usr/sbin/blkid"
    "/usr/sbin/cryptdisks_start"
    "/usr/sbin/cryptdisks_stop"
    "/usr/sbin/cryptsetup"
    "/usr/sbin/dmsetup"
    "/usr/sbin/dmstats"
    "/usr/sbin/iptables-apply"
    "/usr/sbin/luksformat"
    "/usr/sbin/tarcat"
    "/usr/sbin/update-ca-certificates"
    "/usr/sbin/veritysetup"
)

for p in "${stale_runtime_helper_paths[@]}"; do
    rm -rf "$BUILDROOT"$p
done

runtime_bash_paths=(
    "/etc/bash.bashrc"
    "/etc/skel/.bash_logout"
    "/etc/skel/.bashrc"
    "/root/.bash_logout"
    "/root/.bashrc"
    "/usr/bin/bash"
    "/usr/bin/rbash"
    "/usr/share/base-files/dot.bashrc"
    "/usr/share/debianutils/shells.d/bash"
    "/usr/share/dot.bashrc"
)

for p in "${runtime_bash_paths[@]}"; do
    rm -rf "$BUILDROOT"$p
done

for privileged_path in \
    "$BUILDROOT/usr/bin/nvidia-modprobe"; do
    [ -e "$privileged_path" ] || continue
    chmod ug-s "$privileged_path"
done

nvidia_driver_modprobe_conf="$BUILDROOT/usr/lib/modprobe.d/nvidia-graphics-drivers.conf"
if [ -e "$nvidia_driver_modprobe_conf" ]; then
    sed -i \
        -e '/^options nvidia .*NVreg_TemporaryFilePath=/d' \
        -e '/^options nvidia .*NVreg_EnableS0ixPowerManagement=/d' \
        -e '/^options nvidia .*NVreg_PreserveVideoMemoryAllocations=/d' \
        -e '/^# Enable complete power management/,/^$/d' \
        "$nvidia_driver_modprobe_conf"
fi

nvidia_container_config="$BUILDROOT/etc/nvidia-container-runtime/config.toml"
if [ -e "$nvidia_container_config" ]; then
    sed -i -e 's/^load-kmods = true$/load-kmods = false/' "$nvidia_container_config"
fi

if command -v setcap >/dev/null 2>&1; then
    for cap_path in \
        "$BUILDROOT/usr/bin/ping" \
        "$BUILDROOT/usr/bin/ping4" \
        "$BUILDROOT/usr/bin/ping6"; do
        [ -e "$cap_path" ] || continue
        setcap -r "$cap_path" 2>/dev/null || true
    done
fi

# Ubuntu 26.04 maps many coreutils applets through rust-coreutils under
# /usr/lib/cargo/bin/coreutils. Keep that runtime backend, but drop the duplicate
# GNU-prefixed applets and repair compatibility symlinks such as rm -> gnurm.
for symlink in "$BUILDROOT"/usr/bin/*; do
    [ -L "$symlink" ] || continue
    target="$(readlink "$symlink")"
    case "$target" in
        gnu*)
            applet="${target#gnu}"
            if [ -e "$BUILDROOT/usr/lib/cargo/bin/coreutils/$applet" ]; then
                ln -sfn "../lib/cargo/bin/coreutils/$applet" "$symlink"
            fi
            ;;
    esac
done
rm -f "$BUILDROOT"/usr/lib/cargo/bin/su "$BUILDROOT"/usr/lib/cargo/bin/sudo

for tool in iptables ip6tables; do
    if [ -e "$BUILDROOT/usr/sbin/${tool}-nft" ]; then
        ln -sfn "${tool}-nft" "$BUILDROOT/usr/sbin/$tool"
    fi
done

for dir in "$BUILDROOT"/usr/bin "$BUILDROOT"/usr/sbin "$BUILDROOT"/bin "$BUILDROOT"/sbin; do
    [ -d "$dir" ] || continue
    while IFS= read -r -d '' symlink; do
        target="$(readlink "$symlink")"
        case "$target" in
            /*) resolved="$BUILDROOT$target" ;;
            *) resolved="$(dirname "$symlink")/$target" ;;
        esac
        [ -e "$resolved" ] || rm -f "$symlink"
    done < <(find "$dir" -maxdepth 1 -type l -print0)
done

# Firmware is host-influenced device payload. Keep the NVIDIA firmware needed by
# the packaged driver plus CPU microcode for UKI generation; remove the generic
# distro firmware catalog.
if [ -d "$BUILDROOT/usr/lib/firmware" ]; then
    find "$BUILDROOT/usr/lib/firmware" -mindepth 1 -maxdepth 1 \
        ! -name nvidia \
        ! -name amd-ucode \
        ! -name intel-ucode \
        -exec rm -rf {} +
fi

if [ -d "$BUILDROOT/etc/alternatives" ]; then
    while IFS= read -r -d '' symlink; do
        target="$(readlink "$symlink")"
        case "$target" in
            /*) resolved="$BUILDROOT$target" ;;
            *) resolved="$(dirname "$symlink")/$target" ;;
        esac
        [ -e "$resolved" ] || rm -f "$symlink"
    done < <(find "$BUILDROOT/etc/alternatives" -maxdepth 1 -type l -print0)
fi

# Re-run command symlink cleanup after /etc/alternatives pruning. Many /usr/bin
# entries are two-hop links through alternatives, so the first pass can only
# prove that the alternatives link itself exists.
for dir in "$BUILDROOT"/usr/bin "$BUILDROOT"/usr/sbin "$BUILDROOT"/bin "$BUILDROOT"/sbin; do
    [ -d "$dir" ] || continue
    while IFS= read -r -d '' symlink; do
        target="$(readlink "$symlink")"
        case "$target" in
            /*) resolved="$BUILDROOT$target" ;;
            *) resolved="$(dirname "$symlink")/$target" ;;
        esac
        [ -e "$resolved" ] || rm -f "$symlink"
    done < <(find "$dir" -maxdepth 1 -type l -print0)
done

# The stock Ubuntu kernel ships thousands of signed modules, most of them for
# device families a malicious hypervisor could present but Tinfoil never needs.
# Keep a conservative runtime allowlist for the stock-kernel transition:
# attestation, NVIDIA, Docker bridge/overlay/netfilter, dm-crypt/verity,
# virtio-facing rootfs pieces, and their bounded crypto/netfilter dependencies.
# The DRM carve-out is intentionally tiny: the packaged NVIDIA stack needs
# ttm + drm_ttm_helper for nvidia-drm, while the core drm module is built in.
#
# TINFOIL_DEBUG_KEEP_ALL_MODULES=1 is a diagnostic-only split test for GPU
# bring-up: it keeps the no-udev/no-systemd userspace shape but preserves the
# stock module tree so INF14 B300 failures can be attributed to module pruning
# versus PID1/userspace sequencing. Images built with this flag are not TCB
# candidates and are expected to fail the mounted-rootfs tcb-check module gates.
custom_kernel_builtin_dir="$BUILDROOT/usr/lib/tinfoil/custom-kernel"
custom_kernel_builtin_manifest="$custom_kernel_builtin_dir/modules.builtin"
custom_kernel_builtin_release="$custom_kernel_builtin_dir/kernel.release"
install_custom_kernel_builtins() {
    local module_dir="$1"
    local kver="$2"
    local expected_release

    [ -s "$custom_kernel_builtin_manifest" ] || return 0
    [ -s "$custom_kernel_builtin_release" ] || return 0
    expected_release="$(tr -d '\n' < "$custom_kernel_builtin_release")"
    if [ "$expected_release" != "$kver" ]; then
        echo "mkosi.finalize: custom kernel built-in manifest release $expected_release does not match rootfs module tree $kver" >&2
        return 1
    fi

    install -m 0644 "$custom_kernel_builtin_manifest" "$module_dir/modules.builtin"
    echo "mkosi.finalize: installed custom kernel built-in manifest for $kver" >&2
}

if [ "${TINFOIL_DEBUG_KEEP_ALL_MODULES:-0}" = "1" ]; then
    echo "mkosi.finalize: debug build keeps the full rootfs module tree; not a hardened TCB candidate" >&2
    for module_dir in "$BUILDROOT"/usr/lib/modules/*; do
        [ -d "$module_dir" ] || continue
        kver="$(basename "$module_dir")"
        rm -f "$module_dir/build" "$module_dir/source"
        depmod -b "$BUILDROOT" "$kver"
        install_custom_kernel_builtins "$module_dir" "$kver"
    done
else
    for module_dir in "$BUILDROOT"/usr/lib/modules/*; do
        [ -d "$module_dir" ] || continue
        kver="$(basename "$module_dir")"
        while IFS= read -r -d '' module; do
            rel="${module#$module_dir/}"
            case "$rel" in
                updates/dkms/nvidia.ko | \
                updates/dkms/nvidia-modeset.ko | \
                updates/dkms/nvidia-peermem.ko | \
                updates/dkms/nvidia-uvm.ko | \
                updates/tdx-guest.ko | \
                kernel/arch/x86/crypto/aesni-intel.ko.* | \
                kernel/crypto/ecdh_generic.ko.* | \
                kernel/crypto/ecdsa_generic.ko.* | \
                kernel/drivers/acpi/video.ko.* | \
                kernel/drivers/block/loop.ko.* | \
                kernel/drivers/gpu/drm/drm_ttm_helper.ko.* | \
                kernel/drivers/gpu/drm/ttm/ttm.ko.* | \
                kernel/drivers/i2c/algos/i2c-algo-bit.ko.* | \
                kernel/drivers/md/dm-bufio.ko.* | \
                kernel/drivers/md/dm-crypt.ko.* | \
                kernel/drivers/md/dm-verity.ko.* | \
                kernel/drivers/net/tun.ko.* | \
                kernel/drivers/net/veth.ko.* | \
                kernel/drivers/platform/wmi/wmi.ko.* | \
                kernel/drivers/virt/coco/*.ko.* | \
                kernel/drivers/virt/coco/*/*.ko.* | \
                kernel/fs/erofs/*.ko.* | \
                kernel/fs/ext4/*.ko.* | \
                kernel/fs/jbd2/*.ko.* | \
                kernel/fs/mbcache.ko.* | \
                kernel/fs/overlayfs/*.ko.* | \
                kernel/net/802/stp.ko.* | \
                kernel/net/bridge/br_netfilter.ko.* | \
                kernel/net/bridge/bridge.ko.* | \
                kernel/net/ipv4/netfilter/nf_defrag_ipv4.ko.* | \
                kernel/net/ipv6/netfilter/nf_defrag_ipv6.ko.* | \
                kernel/net/llc/llc.ko.* | \
                kernel/net/netfilter/nf_conntrack.ko.* | \
                kernel/net/netfilter/nf_conntrack_netlink.ko.* | \
                kernel/net/netfilter/nf_nat.ko.* | \
                kernel/net/netfilter/nf_tables.ko.* | \
                kernel/net/netfilter/nfnetlink.ko.* | \
                kernel/net/netfilter/nft_chain_nat.ko.* | \
                kernel/net/netfilter/nft_compat.ko.* | \
                kernel/net/netfilter/nft_ct.ko.* | \
                kernel/net/netfilter/x_tables.ko.* | \
                kernel/net/netfilter/xt_MASQUERADE.ko.* | \
                kernel/net/netfilter/xt_addrtype.ko.* | \
                kernel/net/netfilter/xt_conntrack.ko.* | \
                kernel/net/netfilter/xt_nat.ko.* | \
                kernel/net/netfilter/xt_tcpudp.ko.* | \
                kernel/net/sched/sch_fq_codel.ko.*)
                    ;;
                *)
                    rm -f "$module"
                    ;;
            esac
        done < <(find "$module_dir" -type f -name '*.ko*' -print0)

        rm -f "$module_dir/build" "$module_dir/source"
        find "$module_dir" -depth -type d -empty -delete
        depmod -b "$BUILDROOT" "$kver"
        install_custom_kernel_builtins "$module_dir" "$kver"
    done
fi
rm -rf "$custom_kernel_builtin_dir"

runtime_kmod_loader_paths=(
    "/usr/bin/depmod"
    "/usr/bin/insmod"
    "/usr/bin/kmod"
    "/usr/bin/lsmod"
    "/usr/bin/modinfo"
    "/usr/bin/modprobe"
    "/usr/bin/rmmod"
    "/usr/sbin/depmod"
    "/usr/sbin/insmod"
    "/usr/sbin/kmod"
    "/usr/sbin/lsmod"
    "/usr/sbin/modinfo"
    "/usr/sbin/modprobe"
    "/usr/sbin/rmmod"
)

for p in "${runtime_kmod_loader_paths[@]}"; do
    rm -rf "$BUILDROOT"$p
done
rm -f "$BUILDROOT"/usr/lib/x86_64-linux-gnu/libkmod.so.*
