# Live NVIDIA CUDA repo publishes multiple driver branches (e.g. 595.x and
# 610.x). Without version pins, apt mixes branches for unpinned libnvidia-*
# deps and the 595.71.05 driver stack becomes unsatisfiable.
# NOTE: driver rolled back to 595.71.05 because NVIDIA's RIM service has no
# GB110 driver RIM for 610.43.02 (only 595.58.03 / 595.71.05), so GPU
# attestation fails with "Error 104: RIM Not Found". nvattest stays at 1.2.2
# (built from source, see build-nvattest.sh) — it is not pinned here.
Package: libnvidia-* nvidia-* cuda-*
Pin: version 595.71.05*
Pin-Priority: 1002

Package: libnvidia-* nvidia-* cuda-*
Pin: version 610.*
Pin-Priority: -1
